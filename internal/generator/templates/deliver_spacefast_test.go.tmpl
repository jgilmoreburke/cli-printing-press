func TestRenderSpacefastPageEscapesAndTabulates(t *testing.T) {
	body := []byte(`{"results":[{"name":"<script>x</script>","price":129,"link":"https://example.com/a"},{"name":"b","price":99.5}]}`)
	page := string(renderSpacefastPage("demo-page", body))
	for _, want := range []string{"<table>", "<th>name</th>", "<th>price</th>", "&lt;script&gt;", "99.5", `<a href="https://example.com/a">`, "2 rows"} {
		if !strings.Contains(page, want) {
			t.Errorf("rendered page missing %q", want)
		}
	}
	if strings.Contains(page, "<script>x") {
		t.Error("rendered page contains unescaped output")
	}
	if !strings.Contains(page, "<th>name</th><th>price</th><th>link</th>") {
		t.Error("table columns should keep the output's field order")
	}
	enveloped := string(renderSpacefastPage("demo-page", []byte(`{"meta":{"source":"live"},"results":[{"title":"a","source":"x"}]}`)))
	if !strings.Contains(enveloped, "<th>title</th><th>source</th>") {
		t.Error("envelope keys should not reorder row columns")
	}
	nested := string(renderSpacefastPage("demo-page", []byte(`[{"zeta":{"inner":1},"alpha":2}]`)))
	if !strings.Contains(nested, "<th>zeta</th><th>alpha</th>") {
		t.Error("nested objects should not disturb top-level column order")
	}
	plain := string(renderSpacefastPage("demo-page", []byte("NAME  PRICE\n<b>  1\n")))
	if !strings.Contains(plain, "<pre>") || !strings.Contains(plain, "&lt;b&gt;") {
		t.Error("non-JSON output should render escaped inside <pre>")
	}
}

